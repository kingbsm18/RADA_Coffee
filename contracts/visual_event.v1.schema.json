{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "visual_event.v1",
  "type": "object",
  "required": ["schema", "event_id", "site_id", "camera_id", "timestamp", "category", "count", "confidence", "model_version"],
  "properties": {
    "schema": { "const": "visual_event.v1" },
    "event_id": { "type": "string", "format": "uuid", "description": "Idempotency key" },
    "site_id": { "type": "string", "description": "e.g. cafe-01" },
    "camera_id": { "type": "string", "description": "e.g. cam-1" },
    "timestamp": { "type": "string", "format": "date-time", "description": "ISO 8601 with offset; stored as UTC" },
    "category": { "type": "string", "description": "e.g. coffee, soft_drink" },
    "count": { "type": "integer", "minimum": 1, "description": "Number of units this event represents" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "snapshot_ref": { "type": ["string", "null"] },
    "model_version": { "type": "string" }
  },
  "additionalProperties": false
}
