# cloud environment — copy and fill, never commit secrets
TIMEZONE=Africa/Casablanca
# ============================================================
# RADA COFFEE — DEVELOPMENT ENVIRONMENT
# Copy this file to the repository root as .env
# ============================================================

ENVIRONMENT=dev

# PostgreSQL
POSTGRES_USER=rada
POSTGRES_PASSWORD=rada_dev_password
POSTGRES_DB=rada

DATABASE_URL=postgresql+psycopg://rada:rada_dev_password@db:5432/rada

# Authentication — development only
SECRET_KEY=dev_only_secret_for_local_development
ACCESS_TOKEN_MINUTES=60
PASSWORD_HASH_ITERATIONS=600000

# Login protection
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300

# Initial administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=dev_only_admin_password
ADMIN_ORG_NAME=RADA

# Frontend
CORS_ORIGINS=http://localhost:3000

# Snapshot storage
STORAGE_BACKEND=local
SNAPSHOT_DIR=/data/snapshots
SNAPSHOT_MAX_BYTES=2000000
SNAPSHOT_RETENTION_DAYS=30

# S3 — disabled in development
S3_BUCKET=
S3_PREFIX=snapshots

# POS imports
POS_IMPORT_MAX_BYTES=5000000
POS_IMPORT_MAX_ROWS=50000

# Event validation
MAX_FUTURE_SKEW_SECONDS=300

# Business configuration
TIMEZONE=Africa/Casablanca
CURRENCY=MAD

# Feature flags
FEATURE_FLAGS=
