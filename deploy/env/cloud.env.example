# RADA — CLOUD / HYBRID backend. Copy to deploy/env/cloud.env (gitignored) and replace EVERY "change_me".
# Outside dev the backend refuses to start while a secret is still "change_me" (see backend/app/config.py).
#
#   docker compose -f deploy/docker-compose.cloud.yml --env-file deploy/env/cloud.env up -d
#   (add `--profile dashboard` to also run the Next.js dashboard)

ENVIRONMENT=cloud

# Managed PostgreSQL: this compose file has no database container. Use a TLS connection.
DATABASE_URL=postgresql+psycopg://rada:change_me@db.example.internal:5432/rada?sslmode=require

# 32+ random characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me
ACCESS_TOKEN_MINUTES=60

# First administrator, created only while the user table is empty. Uncomment for the first start,
# use 12+ characters, then remove both lines. (Do not leave them empty: an empty value is rejected.)
# ADMIN_USERNAME=founder
# ADMIN_PASSWORD=
# ADMIN_ORG_NAME=RADA

# Exact origin(s) of the dashboard, https only, comma-separated.
CORS_ORIGINS=https://dashboard.example.com

# Photos: use S3 in the cloud. Credentials come from an IAM role on the host (preferred) or from
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_DEFAULT_REGION. S3 storage is NOT yet tested on a real bucket.
STORAGE_BACKEND=s3
S3_BUCKET=change_me
S3_PREFIX=snapshots
SNAPSHOT_MAX_BYTES=2000000
SNAPSHOT_RETENTION_DAYS=30

POS_IMPORT_MAX_BYTES=5000000
POS_IMPORT_MAX_ROWS=50000
MAX_FUTURE_SKEW_SECONDS=300
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300
TIMEZONE=Africa/Casablanca
CURRENCY=MAD

# Only for `--profile dashboard`: public https URL of THIS backend (no /api/v1). The dashboard bakes it
# in at build time. A browser blocks http:// calls from an https:// page.
NEXT_PUBLIC_API_URL=https://api.example.com
