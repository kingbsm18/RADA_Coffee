# local environment — copy and fill, never commit secrets
TIMEZONE=Africa/Casablanca
# ============================================================
# RADA COFFEE — LOCAL CAFE SERVER
# Replace all placeholder secrets before deployment.
# ============================================================

ENVIRONMENT=local

# PostgreSQL
POSTGRES_USER=rada
POSTGRES_PASSWORD=change_me
POSTGRES_DB=rada

# Use "db" when backend and PostgreSQL share a Docker network.
# Use 127.0.0.1 if the backend runs directly on the host.
DATABASE_URL=postgresql+psycopg://rada:change_me@db:5432/rada

# Security — generate a strong random secret
SECRET_KEY=change_me
ACCESS_TOKEN_MINUTES=60
PASSWORD_HASH_ITERATIONS=600000

# Login protection
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300

# Initial administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
ADMIN_ORG_NAME=RADA

# Dashboard — add the café's actual frontend origin
CORS_ORIGINS=http://localhost:3000

# Local snapshot storage
STORAGE_BACKEND=local
SNAPSHOT_DIR=/data/snapshots
SNAPSHOT_MAX_BYTES=2000000
SNAPSHOT_RETENTION_DAYS=30

# S3 disabled
S3_BUCKET=
S3_PREFIX=snapshots

# POS imports
POS_IMPORT_MAX_BYTES=5000000
POS_IMPORT_MAX_ROWS=50000

# Event validation
MAX_FUTURE_SKEW_SECONDS=300

# Business configuration
TIMEZONE=Africa/Casablanca
CURRENCY=MAD

# Feature flags
FEATURE_FLAGS=
