# Copy to .env — never commit real secrets
POSTGRES_USER=rada
POSTGRES_PASSWORD=change_me
POSTGRES_DB=rada
DATABASE_URL=postgresql+psycopg://rada:change_me@db:5432/rada
SECRET_KEY=change_me
STORAGE_BACKEND=local
SNAPSHOT_DIR=/data/snapshots
SNAPSHOT_RETENTION_DAYS=30
TIMEZONE=Africa/Casablanca
CURRENCY=MAD

# --- backend (see backend/app/config.py) ---
ENVIRONMENT=dev            # dev | local | hybrid | cloud (non-dev enforces strong secrets)
# SECRET_KEY must be 32+ random chars outside dev:  python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_USERNAME=
ADMIN_PASSWORD=            # first admin, created only if no user exists (12+ chars outside dev)
CORS_ORIGINS=http://localhost:3000
