# Copy to .env.local (dev) or set in Vercel > Project > Settings > Environment Variables.
# NEXT_PUBLIC_* values are exposed to the browser: NEVER put a secret here.

# Base URL of the RADA backend (FastAPI), without trailing slash and without /api/v1.
# The backend must allow this app's origin in its CORS_ORIGINS setting.
# Production must be https:// (a browser blocks http:// from an https:// page).
NEXT_PUBLIC_API_URL=http://localhost:8000

# OPTIONAL. Base URL of the Secure Stream Gateway (HLS/WebRTC) once it exists.
# Leave empty today: no stream gateway exists in the repository, and Live Operations
# then shows "flux indisponible" instead of faking a video. Never put RTSP credentials here.
NEXT_PUBLIC_STREAM_GATEWAY_URL=
